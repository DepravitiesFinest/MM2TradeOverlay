<Window x:Class="TradeValueOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TradeValueOverlay"
        Title="MM2 Trade Overlay"
        Icon="{DynamicResource LogoImage}"
        Width="1000" Height="700" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Background="#08FFFFFF">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Image Source="{DynamicResource LogoImage}" Width="38" Height="38" Margin="0,0,0,22"
                               RenderOptions.BitmapScalingMode="HighQuality" ToolTip="MM2 Trade Overlay"/>
                        <RadioButton x:Name="NavTrade" Style="{StaticResource NavItem}" Content="Trade" Tag="&#xE8AB;" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavValues" Style="{StaticResource NavItem}" Content="Values" Tag="&#xE8FD;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Content="Settings" Tag="&#xE713;" Checked="Nav_Checked"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                               FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>

                <Grid x:Name="PageHost" Grid.Row="1"/>

                <Border x:Name="ToastCard" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"
                        Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="14,11,18,11" MaxWidth="560" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.45"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="ToastIconHost" Width="22" Height="22" CornerRadius="11" Margin="0,0,11,0" VerticalAlignment="Top">
                            <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" FontSize="11"/>
                        </Border>
                        <TextBlock x:Name="ToastText" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="480"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
