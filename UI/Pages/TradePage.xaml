<UserControl x:Class="TradeValueOverlay.TradePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,4,40,40" MaxWidth="920">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Trade check" Style="{StaticResource PageTitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Press" Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="13"/>
                        <ContentControl x:Name="ScanKeys" Margin="4,0" Focusable="False"/>
                        <TextBlock Text="in Murder Mystery 2 to check a trade without leaving the game." Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="RecalibrateButton" Style="{StaticResource GhostButton}" Click="Calibrate_Click" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Recalibrate"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Click="Scan_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ScanButtonText" Text="Scan now"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border x:Name="OcrBanner" Margin="0,24,0,0" CornerRadius="12" Background="{DynamicResource LossSoftBrush}" Padding="16,14" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" Foreground="{DynamicResource LossBrush}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Windows text recognition isn't installed" FontWeight="SemiBold"/>
                        <TextBlock x:Name="OcrText" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Open language settings" Click="FixOcr_Click"
                            VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <Border x:Name="SetupCard" Style="{StaticResource Card}" Margin="0,24,0,0" Padding="28,26" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Set up your capture regions" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Takes about ten seconds, and you only do it once." Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,20"/>
                        <ItemsControl x:Name="SetupSteps" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource AccentHotBrush}"
                                                   VerticalAlignment="Top" Margin="0,2,16,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Click="Calibrate_Click" Height="40" Padding="20,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Start setup"/>
                            <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="12" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border x:Name="EmptyCard" Style="{StaticResource Card}" Margin="0,24,0,0" Padding="28,44" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="{DynamicResource LogoImage}" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
                    <TextBlock Text="Ready when you are" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" TextAlignment="Center" MaxWidth="400" Margin="0,8,0,0" LineHeight="20"
                               Text="Open a trade in MM2 and press the scan shortcut. The verdict pops up over the game, and the full breakdown shows here."/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                <Grid Margin="2,28,0,10">
                    <TextBlock Text="Last result" Style="{StaticResource SectionLabel}" Margin="0"/>
                    <TextBlock x:Name="ResultTime" HorizontalAlignment="Right" Style="{StaticResource Muted}"/>
                </Grid>

                <ContentControl x:Name="Hero" Content="{Binding}" ContentTemplate="{StaticResource VerdictHero}" Focusable="False"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <ContentControl Content="{Binding Give}" ContentTemplate="{StaticResource OfferSection}" Focusable="False"/>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <ContentControl Content="{Binding Get}" ContentTemplate="{StaticResource OfferSection}" Focusable="False"/>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Note}" Margin="2,18,0,0" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" LineHeight="19" Foreground="{DynamicResource TextMutedBrush}"/>
                </Border>

                <TextBlock Text="What the scanner saw" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="YourPreview" Height="120" CornerRadius="9" Background="{DynamicResource Surface2Brush}" ClipToBounds="True"/>
                            <Border x:Name="TheirPreview" Grid.Column="2" Height="120" CornerRadius="9" Background="{DynamicResource Surface2Brush}" ClipToBounds="True"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="2,12,0,0" Foreground="{DynamicResource TextFaintBrush}"
                                   Text="Green boxes are recognised items, amber ones are text that didn't match anything. If the image doesn't show the offer, recalibrate."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
