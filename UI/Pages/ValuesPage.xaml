<UserControl x:Class="TradeValueOverlay.ValuesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,4,40,28" MaxWidth="920">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Values" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="SourceText" Style="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                <Button x:Name="UpdateButton" Style="{StaticResource SecondaryButton}" Click="Update_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="UpdateIcon" Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="UpdateSpin"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="UpdateText" Text="Update values"/>
                    </StackPanel>
                </Button>
                <ProgressBar x:Name="Progress" Style="{StaticResource SlimProgress}" Margin="2,8,2,0" Visibility="Hidden"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,20,0,0" CornerRadius="12" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" LineHeight="19">
                        Cheaper items aren't priced in value. They're priced in Tier-1 items of a rarity, shown as
                        <Run Text="L" Foreground="{DynamicResource LegendaryBrush}" FontWeight="Bold"/>,
                        <Run Text="R" Foreground="{DynamicResource RareBrush}" FontWeight="Bold"/>,
                        <Run Text="U" Foreground="{DynamicResource UncommonBrush}" FontWeight="Bold"/> and
                        <Run Text="C" Foreground="{DynamicResource CommonBrush}" FontWeight="Bold"/>.
                        Totals convert them with the site's ladder:
                        <Run Text="6 C = 1 U  ·  6 U = 1 R  ·  6 R = 1 L  ·  5 L = 1 value" Foreground="{DynamicResource TextBrush}"/>.
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="Search items, e.g. Harvester or Knife Box 4" TextChanged="Search_Changed"/>
                <Border Grid.Column="1" Style="{StaticResource SegmentHost}" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Sort order">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Sort" Content="Value" Tag="value" IsChecked="True" Checked="Sort_Checked"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Sort" Content="Demand" Tag="demand" Checked="Sort_Checked"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Sort" Content="Name" Tag="name" Checked="Sort_Checked"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource SegmentHost}" Margin="0,10,0,0" HorizontalAlignment="Left">
                <StackPanel x:Name="FilterPanel" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="UnitFilter" Content="All" Tag="" IsChecked="True" Checked="Filter_Checked"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="UnitFilter" Content="Value" Tag="Value" Checked="Filter_Checked"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="UnitFilter" Tag="Legendary" Checked="Filter_Checked">
                        <TextBlock><Run Text="L" Foreground="{DynamicResource LegendaryBrush}" FontWeight="Bold"/> Legendary</TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Segment}" GroupName="UnitFilter" Tag="Rare" Checked="Filter_Checked">
                        <TextBlock><Run Text="R" Foreground="{DynamicResource RareBrush}" FontWeight="Bold"/> Rare</TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Segment}" GroupName="UnitFilter" Tag="Uncommon" Checked="Filter_Checked">
                        <TextBlock><Run Text="U" Foreground="{DynamicResource UncommonBrush}" FontWeight="Bold"/> Uncommon</TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Segment}" GroupName="UnitFilter" Tag="Common" Checked="Filter_Checked">
                        <TextBlock><Run Text="C" Foreground="{DynamicResource CommonBrush}" FontWeight="Bold"/> Common</TextBlock>
                    </RadioButton>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8,8,4,8">
            <Grid>
                <ListBox x:Name="List" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource ValueRow}"/>
                <StackPanel x:Name="NoResults" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource TextFaintBrush}"/>
                    <TextBlock Text="No items match" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
