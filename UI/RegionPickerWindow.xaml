<Window x:Class="TradeValueOverlay.RegionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibrate capture regions"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Background="Black" Cursor="Cross"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Image x:Name="Shot" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

        <Canvas x:Name="Layer" Background="Transparent" ClipToBounds="True">
            <Path x:Name="Dim" Fill="#B3000000"/>
        </Canvas>

        <Border x:Name="Instructions" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,36,0,0"
                Background="#F2121419" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                CornerRadius="14" Padding="22,16" Cursor="Arrow" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel MinWidth="380">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="StepDot1" Width="22" Height="4" CornerRadius="2" Margin="0,0,5,0"/>
                    <Border x:Name="StepDot2" Width="22" Height="4" CornerRadius="2"/>
                    <TextBlock x:Name="StepText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaintBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBlock x:Name="HintText" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="460"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Foreground="{DynamicResource TextFaintBrush}" FontSize="12">
                        <Run Text="Drag" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold"/> <Run Text="to select   ·   "/>
                        <Run Text="Right-click" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold"/> <Run Text="to undo   ·   "/>
                        <Run Text="Esc" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold"/> <Run Text="to cancel"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="ConfirmBar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,48"
                Background="#F2121419" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                CornerRadius="14" Padding="10" Cursor="Arrow" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Look right?" VerticalAlignment="Center" Margin="10,0,16,0" Foreground="{DynamicResource TextMutedBrush}"/>
                <Button Content="Redo" Style="{StaticResource SecondaryButton}" Click="Redo_Click" Margin="0,0,8,0"/>
                <Button Content="Save regions" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
